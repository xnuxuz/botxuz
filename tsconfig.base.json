{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  // Test tidak ikut dibuild: hasil kompilasinya di dist akan ditemukan ulang
  // oleh vitest sehingga tiap test jalan dua kali, dan test tidak perlu ikut
  // masuk ke image produksi.
  "exclude": ["node_modules", "dist", ".next", "**/*.test.ts", "**/*.test.tsx"]
}
