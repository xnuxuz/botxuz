# Salin ke .env dan isi. File .env TIDAK PERNAH masuk git (REQUIREMENT §5.2).

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=debug
# DB selalu UTC; konversi ke Asia/Jakarta dilakukan di edge/client.
TZ=UTC

# ---------------------------------------------------------------- database
MYSQL_ROOT_PASSWORD=ganti-password-root-ini
MYSQL_DATABASE=xnuxuz
MYSQL_USER=xnuxuz
MYSQL_PASSWORD=ganti-password-ini
# Port host untuk container MySQL (di dalam container tetap 3306).
MYSQL_PORT=3316
DATABASE_URL=mysql://xnuxuz:ganti-password-ini@localhost:3316/xnuxuz

# ---------------------------------------------------------------- redis
# Port host untuk container Redis (di dalam container tetap 6379).
REDIS_PORT=6389
REDIS_URL=redis://localhost:6389

# ---------------------------------------------------------------- auth
# Generate dengan: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------- api
PORT=3011
CORS_ORIGINS=http://localhost:3010

# ---------------------------------------------------------------- worker
API_BASE_URL=http://localhost:3011
WORKER_CONCURRENCY=4

# ---------------------------------------------------------------- web
WEB_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:3011

# ---------------------------------------------------------------- telegram
# Ambil dari @BotFather. Kosongkan kalau belum mau menjalankan bot.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- ai (fase 2)
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------- deploy
# Dipakai Caddy di VPS. Untuk lokal biarkan localhost.
DOMAIN=localhost
