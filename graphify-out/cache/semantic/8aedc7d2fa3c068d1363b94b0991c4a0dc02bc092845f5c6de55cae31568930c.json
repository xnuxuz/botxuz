{"nodes": [{"id": "requirement_personal_life_os", "label": "xnuxuz Personal Life OS", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 1 Visi Produk", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Single user (Adam) initially, but architecture is multi-user from day one (user_id on every table) so it can become SaaS later without a large refactor. API-first, single VPS, free-tier services, budget Rp1.5jt/year."}, {"id": "requirement_schedule_assistant_module", "label": "Schedule & Assistant Module", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.2", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Recurring events use RRULE format specifically for Google Calendar compatibility."}, {"id": "requirement_grinding_productivity_module", "label": "Grinding / Productivity Module", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.3", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null}, {"id": "requirement_finance_module", "label": "Finance Module", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.4", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Money stored as INTEGER rupiah (never float); soft delete + audit trail + daily backups because corrupted/lost finance data would destroy trust in the whole system. Bank sync/scraping explicitly excluded (Won't have) due to risk and maintenance cost."}, {"id": "requirement_ai_assistant_layer", "label": "AI Assistant Layer", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "AI write actions always require user confirmation via Telegram inline buttons before insert, to prevent bad parses from corrupting data."}, {"id": "requirement_intent_router", "label": "Intent Router", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Single natural-language endpoint that classifies intent then function-calls a minimal schema: createTask, createEvent, createTransaction, getSchedule, getBalance, getSpendingReport, getTasks, logSession."}, {"id": "requirement_context_assembler", "label": "Context Assembler", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Per-request context ordering: 1) user_facts structured memory, 2) today's context (schedule, tasks, balance, streak), 3) deterministic correction rules override, 4) RAG retrieval in phase 2."}, {"id": "requirement_user_facts", "label": "user_facts Structured Memory", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 3.5, 6", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null}, {"id": "requirement_correction_rules", "label": "Correction Rules", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 3.5, 6", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Deterministic overrides that trump LLM output; user category corrections become permanent rules."}, {"id": "requirement_ai_feedback_loop", "label": "AI Feedback Loop", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null}, {"id": "requirement_memory_extraction_pipeline", "label": "Memory Extraction Pipeline", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null}, {"id": "requirement_rag_episodic_memory", "label": "RAG Episodic Memory", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Per-session conversation summaries embedded via Gemini text-embedding-004 or bge-m3, stored in Redis vector search, retrieved with hybrid vector + temporal/category filters."}, {"id": "requirement_notification_service", "label": "NotificationService", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 3.6", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Single abstraction NotificationService.send(userId, payload, {channels, priority}) with one adapter per channel, so new channels can be added without touching other modules. BullMQ job ID unique per (task_id + time) for idempotency so reminders never double-fire."}, {"id": "requirement_telegram_bot", "label": "Telegram Bot Channel", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 3.6, 5.1", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Primary channel. Uses long polling instead of webhook so the bot needs no public endpoint \u2014 simpler on a single VPS. Account linking via one-time code /link ABC123."}, {"id": "requirement_express_api", "label": "Express API", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 5.4", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Single source of truth: all clients (bot, web, mobile) only consume the REST API, zero business logic in client/bot handlers. Versioned /api/v1 from day one. Modular monolith (folder per module) chosen explicitly over microservices for this scale."}, {"id": "requirement_mysql", "label": "MySQL Main Database", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 5.1, 5.2", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Daily mysqldump via cron, 7 days local retention plus weekly upload to Google Drive \u2014 finance data must never be lost. All timestamps UTC in DB, timezone conversion (Asia/Jakarta) at edge/client."}, {"id": "requirement_redis_stack", "label": "Redis Stack", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 5.1", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "redis-stack image chosen for RediSearch vector capability; also holds refresh token rotation/revocation list, rate-limit store, and AI response cache."}, {"id": "requirement_bullmq", "label": "BullMQ Background Jobs", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 5.1", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "All background work (reminders, recurring events/transactions, memory extraction, digest) goes through BullMQ; bull-board dashboard on an authed route for job inspection."}, {"id": "requirement_daily_briefing", "label": "Daily Briefing", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.2", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Morning Telegram digest at a configurable hour: today's schedule, priority tasks, remaining daily budget. Generated once per day (not per request) to stay under free-tier LLM and email limits."}, {"id": "requirement_quick_entry", "label": "Quick Entry via Chat", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 3.4, 4.1", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Flow: 'keluar 25rb makan siang gofood' -> AI parse -> confirm -> insert. On mobile the quick expense screen is max 3 taps because low friction is what makes the recording habit stick."}, {"id": "requirement_regex_fallback_parser", "label": "Regex Fallback Parser", "file_type": "rationale", "source_file": "REQUIREMENT.MD", "source_location": "Section 5.3", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Graceful degradation: when the LLM is down or rate-limited, quick entry falls back to a simple regex parser ('keluar {angka}{rb/jt} {teks}') so expense logging never fully breaks."}, {"id": "requirement_llm_provider_abstraction", "label": "LLM Provider Abstraction", "file_type": "rationale", "source_file": "REQUIREMENT.MD", "source_location": "Sections 5.5, 8", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Free-tier LLM terms may change, so all LLM access goes through one provider interface (@xnuxuz/ai package) allowing Groq <-> Gemini swap via env var; combined with the regex fallback this mitigates the 'AI layer dies' risk. Self-hosting Ollama on the VPS is explicitly forbidden (RAM budget)."}, {"id": "requirement_offline_first_expense_entry", "label": "Offline-first Expense Entry", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 4.1", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Expenses are often recorded where signal is bad (warung, basement), so mobile stores locally in expo-sqlite and syncs via a queue when online. Last-write-wins conflict resolution is deemed sufficient for a single user; every record carries a client_generated_id UUID for dedup during sync."}, {"id": "requirement_google_calendar_sync", "label": "Google Calendar Sync", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 3.2", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Two-way sync via OAuth2 with minimal calendar.events scope; events store gcal_id for mapping."}, {"id": "requirement_moon_monorepo", "label": "moon Monorepo", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 5.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "moon chosen over Turborepo/Nx because it is lightweight, has explicit YAML config, built-in toolchain management (no separate volta/nvm), and solid task graph + caching for this repo scale. Layout: apps/{api,worker,web,mobile} + packages/{shared,db,ai}. moon ci in GitHub Actions builds only affected projects to save free-tier CI minutes."}, {"id": "requirement_biome", "label": "Biome Lint/Format", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 5.5", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Single tool replacing ESLint + Prettier with one root biome.json. Missing ESLint plugin coverage (e.g. eslint-plugin-security) is an accepted trade-off for ~25x speed (Rust-based) and zero config fatigue. Enforced via pre-commit hook and CI gate."}, {"id": "requirement_mobile_app", "label": "Mobile App (Expo)", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Expo/React Native chosen to reuse existing React/Next.js skill. Tokens in SecureStore, not AsyncStorage. Android-only sideload APK first; iOS skipped ($99/yr outside budget)."}, {"id": "requirement_web_dashboard", "label": "Next.js Web Dashboard", "file_type": "concept", "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 7", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null}, {"id": "requirement_data_model", "label": "Data Model (Entity Summary)", "file_type": "document", "source_file": "REQUIREMENT.MD", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Every table carries user_id from day one for future multi-tenancy. Tables: users, user_facts, correction_rules, ai_feedback, memory_episodes, events, reminders, tasks, sessions, goals, accounts, transactions, budgets, recurring_txn, categories, notif_prefs."}, {"id": "requirement_phased_roadmap", "label": "Phased Build Roadmap", "file_type": "rationale", "source_file": "REQUIREMENT.MD", "source_location": "Sections 7, 8", "source_url": null, "captured_at": null, "author": "Adam", "contributor": null, "rationale": "Strict phase gating: phase n+1 starts only after phase n is in daily use \u2014 mitigates scope creep across 7 modules. Real usage data from phases 1-3 fuels the memory phase and validates UX before investing in mobile."}], "edges": [{"source": "requirement_personal_life_os", "target": "requirement_schedule_assistant_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 1", "weight": 1.0}, {"source": "requirement_personal_life_os", "target": "requirement_grinding_productivity_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 1", "weight": 1.0}, {"source": "requirement_personal_life_os", "target": "requirement_finance_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 1", "weight": 1.0}, {"source": "requirement_personal_life_os", "target": "requirement_ai_assistant_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 1", "weight": 1.0}, {"source": "requirement_personal_life_os", "target": "requirement_notification_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.6", "weight": 1.0}, {"source": "requirement_telegram_bot", "target": "requirement_express_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 2 architecture rules", "weight": 1.0}, {"source": "requirement_web_dashboard", "target": "requirement_express_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 2 architecture rules", "weight": 1.0}, {"source": "requirement_mobile_app", "target": "requirement_express_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 2 architecture rules", "weight": 1.0}, {"source": "requirement_express_api", "target": "requirement_mysql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 2 diagram", "weight": 1.0}, {"source": "requirement_express_api", "target": "requirement_redis_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 2 diagram", "weight": 1.0}, {"source": "requirement_ai_assistant_layer", "target": "requirement_intent_router", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "weight": 1.0}, {"source": "requirement_ai_assistant_layer", "target": "requirement_context_assembler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5", "weight": 1.0}, {"source": "requirement_context_assembler", "target": "requirement_user_facts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5 context list item 1", "weight": 1.0}, {"source": "requirement_context_assembler", "target": "requirement_correction_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5 context list item 3", "weight": 1.0}, {"source": "requirement_context_assembler", "target": "requirement_rag_episodic_memory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5 context list item 4", "weight": 1.0}, {"source": "requirement_memory_extraction_pipeline", "target": "requirement_user_facts", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5 (upsert user_facts)", "weight": 1.0}, {"source": "requirement_ai_feedback_loop", "target": "requirement_correction_rules", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5 (koreksi kategori jadi rule permanen)", "weight": 1.0}, {"source": "requirement_memory_extraction_pipeline", "target": "requirement_bullmq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 2 (memory extraction via BullMQ)", "weight": 1.0}, {"source": "requirement_rag_episodic_memory", "target": "requirement_redis_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.5 (Redis vector search)", "weight": 1.0}, {"source": "requirement_bullmq", "target": "requirement_redis_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Sections 2, 5.1 (Redis Stack + BullMQ)", "weight": 1.0}, {"source": "requirement_notification_service", "target": "requirement_bullmq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.6 idempotency", "weight": 1.0}, {"source": "requirement_notification_service", "target": "requirement_telegram_bot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.6 adapter Telegram", "weight": 1.0}, {"source": "requirement_daily_briefing", "target": "requirement_telegram_bot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.2", "weight": 1.0}, {"source": "requirement_daily_briefing", "target": "requirement_schedule_assistant_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.2", "weight": 1.0}, {"source": "requirement_daily_briefing", "target": "requirement_finance_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.2 (sisa budget harian in briefing)", "weight": 1.0}, {"source": "requirement_quick_entry", "target": "requirement_finance_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.4", "weight": 1.0}, {"source": "requirement_quick_entry", "target": "requirement_intent_router", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "REQUIREMENT.MD", "source_location": "Sections 3.4, 3.5 (AI parse maps to createTransaction function call)", "weight": 1.0}, {"source": "requirement_regex_fallback_parser", "target": "requirement_quick_entry", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 5.3 graceful degradation", "weight": 1.0}, {"source": "requirement_regex_fallback_parser", "target": "requirement_intent_router", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "REQUIREMENT.MD", "source_location": "Sections 3.5, 5.3 (both turn NL text into a structured action, different mechanisms)", "weight": 1.0}, {"source": "requirement_llm_provider_abstraction", "target": "requirement_ai_assistant_layer", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 8 risk mitigation", "weight": 1.0}, {"source": "requirement_mobile_app", "target": "requirement_offline_first_expense_entry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 4.1", "weight": 1.0}, {"source": "requirement_offline_first_expense_entry", "target": "requirement_data_model", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Sections 4.1, 6 (client_generated_id column on transactions)", "weight": 1.0}, {"source": "requirement_offline_first_expense_entry", "target": "requirement_quick_entry", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "REQUIREMENT.MD", "source_location": "Sections 3.4, 4.1 (both are low-friction expense capture paths, chat vs mobile)", "weight": 1.0}, {"source": "requirement_google_calendar_sync", "target": "requirement_schedule_assistant_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 3.2", "weight": 1.0}, {"source": "requirement_finance_module", "target": "requirement_data_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 6 (accounts, transactions, budgets, recurring_txn)", "weight": 1.0}, {"source": "requirement_schedule_assistant_module", "target": "requirement_data_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 6 (events, reminders)", "weight": 1.0}, {"source": "requirement_grinding_productivity_module", "target": "requirement_data_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 6 (tasks, sessions, goals)", "weight": 1.0}, {"source": "requirement_data_model", "target": "requirement_mysql", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Sections 3.5, 6 (structured memory in MySQL)", "weight": 1.0}, {"source": "requirement_moon_monorepo", "target": "requirement_biome", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Section 5.5 (biome.json at monorepo root, moon run :lint CI gate)", "weight": 1.0}, {"source": "requirement_phased_roadmap", "target": "requirement_personal_life_os", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD", "source_location": "Sections 7, 8", "weight": 1.0}], "hyperedges": [{"id": "life_os_core_domains", "label": "Three Life Domains of the Personal Life OS", "nodes": ["requirement_schedule_assistant_module", "requirement_grinding_productivity_module", "requirement_finance_module"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD"}, {"id": "ai_personalization_memory_loop", "label": "AI Personalization Memory Loop", "nodes": ["requirement_context_assembler", "requirement_user_facts", "requirement_correction_rules", "requirement_ai_feedback_loop", "requirement_memory_extraction_pipeline", "requirement_rag_episodic_memory"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD"}, {"id": "single_vps_docker_stack", "label": "Single-VPS Docker Compose Stack", "nodes": ["requirement_express_api", "requirement_mysql", "requirement_redis_stack", "requirement_bullmq", "requirement_telegram_bot", "requirement_web_dashboard"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REQUIREMENT.MD"}]}