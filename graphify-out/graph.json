    {
      "label": "RAG Episodic Memory",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 3.5",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Per-session conversation summaries embedded via Gemini text-embedding-004 or bge-m3, stored in Redis vector search, retrieved with hybrid vector + temporal/category filters.",
      "id": "requirement_rag_episodic_memory",
      "community": 0,
      "norm_label": "rag episodic memory"
    },
    {
      "label": "NotificationService",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 2, 3.6",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Single abstraction NotificationService.send(userId, payload, {channels, priority}) with one adapter per channel, so new channels can be added without touching other modules. BullMQ job ID unique per (task_id + time) for idempotency so reminders never double-fire.",
      "id": "requirement_notification_service",
      "community": 1,
      "norm_label": "notificationservice"
    },
    {
      "label": "Telegram Bot Channel",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 2, 3.6, 5.1",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Primary channel. Uses long polling instead of webhook so the bot needs no public endpoint \u2014 simpler on a single VPS. Account linking via one-time code /link ABC123.",
      "id": "requirement_telegram_bot",
      "community": 1,
      "norm_label": "telegram bot channel"
    },
    {
      "label": "Express API",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 2, 5.4",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Single source of truth: all clients (bot, web, mobile) only consume the REST API, zero business logic in client/bot handlers. Versioned /api/v1 from day one. Modular monolith (folder per module) chosen explicitly over microservices for this scale.",
      "id": "requirement_express_api",
      "community": 2,
      "norm_label": "express api"
    },
    {
      "label": "MySQL Main Database",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 2, 5.1, 5.2",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Daily mysqldump via cron, 7 days local retention plus weekly upload to Google Drive \u2014 finance data must never be lost. All timestamps UTC in DB, timezone conversion (Asia/Jakarta) at edge/client.",
      "id": "requirement_mysql",
      "community": 2,
      "norm_label": "mysql main database"
    },
    {
      "label": "Redis Stack",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 2, 5.1",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "redis-stack image chosen for RediSearch vector capability; also holds refresh token rotation/revocation list, rate-limit store, and AI response cache.",
      "id": "requirement_redis_stack",
      "community": 0,
      "norm_label": "redis stack"
    },
    {
      "label": "BullMQ Background Jobs",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 2, 5.1",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "All background work (reminders, recurring events/transactions, memory extraction, digest) goes through BullMQ; bull-board dashboard on an authed route for job inspection.",
      "id": "requirement_bullmq",
      "community": 0,
      "norm_label": "bullmq background jobs"
    },
    {
      "label": "Daily Briefing",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 3.2",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Morning Telegram digest at a configurable hour: today's schedule, priority tasks, remaining daily budget. Generated once per day (not per request) to stay under free-tier LLM and email limits.",
      "id": "requirement_daily_briefing",
      "community": 1,
      "norm_label": "daily briefing"
    },
    {
      "label": "Quick Entry via Chat",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 3.4, 4.1",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Flow: 'keluar 25rb makan siang gofood' -> AI parse -> confirm -> insert. On mobile the quick expense screen is max 3 taps because low friction is what makes the recording habit stick.",
      "id": "requirement_quick_entry",
      "community": 3,
      "norm_label": "quick entry via chat"
    },
    {
      "label": "Regex Fallback Parser",
      "file_type": "rationale",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 5.3",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Graceful degradation: when the LLM is down or rate-limited, quick entry falls back to a simple regex parser ('keluar {angka}{rb/jt} {teks}') so expense logging never fully breaks.",
      "id": "requirement_regex_fallback_parser",
      "community": 3,
      "norm_label": "regex fallback parser"
    },
    {
      "label": "LLM Provider Abstraction",
      "file_type": "rationale",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 5.5, 8",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Free-tier LLM terms may change, so all LLM access goes through one provider interface (@xnuxuz/ai package) allowing Groq <-> Gemini swap via env var; combined with the regex fallback this mitigates the 'AI layer dies' risk. Self-hosting Ollama on the VPS is explicitly forbidden (RAM budget).",
      "id": "requirement_llm_provider_abstraction",
      "community": 3,
      "norm_label": "llm provider abstraction"
    },
    {
      "label": "Offline-first Expense Entry",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 4.1",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Expenses are often recorded where signal is bad (warung, basement), so mobile stores locally in expo-sqlite and syncs via a queue when online. Last-write-wins conflict resolution is deemed sufficient for a single user; every record carries a client_generated_id UUID for dedup during sync.",
      "id": "requirement_offline_first_expense_entry",
      "community": 2,
      "norm_label": "offline-first expense entry"
    },
    {
      "label": "Google Calendar Sync",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 3.2",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Two-way sync via OAuth2 with minimal calendar.events scope; events store gcal_id for mapping.",
      "id": "requirement_google_calendar_sync",
      "community": 1,
      "norm_label": "google calendar sync"
    },
    {
      "label": "moon Monorepo",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 5.5",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "moon chosen over Turborepo/Nx because it is lightweight, has explicit YAML config, built-in toolchain management (no separate volta/nvm), and solid task graph + caching for this repo scale. Layout: apps/{api,worker,web,mobile} + packages/{shared,db,ai}. moon ci in GitHub Actions builds only affected projects to save free-tier CI minutes.",
      "id": "requirement_moon_monorepo",
      "community": 4,
      "norm_label": "moon monorepo"
    },
    {
      "label": "Biome Lint/Format",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 5.5",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Single tool replacing ESLint + Prettier with one root biome.json. Missing ESLint plugin coverage (e.g. eslint-plugin-security) is an accepted trade-off for ~25x speed (Rust-based) and zero config fatigue. Enforced via pre-commit hook and CI gate.",
      "id": "requirement_biome",
      "community": 4,
      "norm_label": "biome lint/format"
    },
    {
      "label": "Mobile App (Expo)",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 4",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Expo/React Native chosen to reuse existing React/Next.js skill. Tokens in SecureStore, not AsyncStorage. Android-only sideload APK first; iOS skipped ($99/yr outside budget).",
      "id": "requirement_mobile_app",
      "community": 2,
      "norm_label": "mobile app (expo)"
    },
    {
      "label": "Next.js Web Dashboard",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 2, 7",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "id": "requirement_web_dashboard",
      "community": 2,
      "norm_label": "next.js web dashboard"
    },
    {
      "label": "Data Model (Entity Summary)",
      "file_type": "document",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 6",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Every table carries user_id from day one for future multi-tenancy. Tables: users, user_facts, correction_rules, ai_feedback, memory_episodes, events, reminders, tasks, sessions, goals, accounts, transactions, budgets, recurring_txn, categories, notif_prefs.",
      "id": "requirement_data_model",
      "community": 2,
      "norm_label": "data model (entity summary)"
    },
    {
      "label": "Phased Build Roadmap",
      "file_type": "rationale",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Sections 7, 8",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Strict phase gating: phase n+1 starts only after phase n is in daily use \u2014 mitigates scope creep across 7 modules. Real usage data from phases 1-3 fuels the memory phase and validates UX before investing in mobile.",
      "id": "requirement_phased_roadmap",
      "community": 1,
      "norm_label": "phased build roadmap"
    }
