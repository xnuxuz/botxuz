    },
    {
      "label": "Finance Module",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 3.4",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Money stored as INTEGER rupiah (never float); soft delete + audit trail + daily backups because corrupted/lost finance data would destroy trust in the whole system. Bank sync/scraping explicitly excluded (Won't have) due to risk and maintenance cost.",
      "id": "requirement_finance_module",
      "community": 1,
      "norm_label": "finance module"
    },
    {
      "label": "AI Assistant Layer",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 3.5",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "AI write actions always require user confirmation via Telegram inline buttons before insert, to prevent bad parses from corrupting data.",
      "id": "requirement_ai_assistant_layer",
      "community": 3,
      "norm_label": "ai assistant layer"
    },
    {
      "label": "Intent Router",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 3.5",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Single natural-language endpoint that classifies intent then function-calls a minimal schema: createTask, createEvent, createTransaction, getSchedule, getBalance, getSpendingReport, getTasks, logSession.",
      "id": "requirement_intent_router",
      "community": 3,
      "norm_label": "intent router"
    },
    {
      "label": "Context Assembler",
      "file_type": "concept",
      "source_file": "REQUIREMENT.MD",
      "source_location": "Section 3.5",
      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Per-request context ordering: 1) user_facts structured memory, 2) today's context (schedule, tasks, balance, streak), 3) deterministic correction rules override, 4) RAG retrieval in phase 2.",
      "id": "requirement_context_assembler",
      "community": 0,
      "norm_label": "context assembler"
    },
    {
      "label": "user_facts Structured Memory",
      "file_type": "concept",
