      "source_url": null,
      "captured_at": null,
      "author": "Adam",
      "contributor": null,
      "rationale": "Single user (Adam) initially, but architecture is multi-user from day one (user_id on every table) so it can become SaaS later without a large refactor. API-first, single VPS, free-tier services, budget Rp1.5jt/year.",
      "id": "requirement_personal_life_os",
      "community": 1,
      "norm_label": "xnuxuz personal life os"
    },
    {
      "label": "Schedule & Assistant Module",
      "file_type": "concept",
